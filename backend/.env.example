# API configuration
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# Keep false during frontend/prototype work. DATABASE_URL alone never enables DB access.
DATABASE_ENABLED=false
# Set only when intentionally enabling the backend connection.
DATABASE_URL=
# Required before enabling authentication endpoints. Use a random secret of 32+ bytes.
AUTH_TOKEN_SECRET=
# SMTP used for activation, password resets, payment receipts, and result-release notices.
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=smtp
# Hosts that block SMTP on 25/465/587 (Render free instances) retry once on this port.
MAIL_FALLBACK_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Labstream
